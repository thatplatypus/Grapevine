  📗 What the server saw of *r*, as "name=value" lines. 📗
  🐇❗️ 📋 r 📨 ➡️ 🔡 🍇
    🆕🔠❗️ ➡️ out
    🐻 out 🔤method=🧲🚦 r❗️🧲❌n🔤❗️
    🐻 out 🔤path=🧲🛣 r❗️🧲❌n🔤❗️
    🐻 out 🔤version=🧲🧬 r❗️🧲❌n🔤❗️
    🐻 out 🔤peer=🧲🌐 r❗️🧲❌n🔤❗️
    ↪️ 📌 r 🔤value🔤❗️ ➡️ value 🍇
      🐻 out 🔤param.value=🧲value🧲❌n🔤❗️
    🍉
    🔂 name 🗝 r❗️ 🍇
      🔂 value 🔭 r name❗️ 🍇
        🐻 out 🔤query.🧲name🧲=🧲value🧲❌n🔤❗️
      🍉
    🍉
    🔂 name 🐙 r❗️ 🍇
      ↪️ 🏷 r name❗️ ➡️ value 🍇
        🐻 out 🔤header.🧲name🧲=🧲value🧲❌n🔤❗️
      🍉
    🍉
    🐻 out 🔤bodyLength=🧲📏 📇 r❗️❓🧲❌n🔤❗️
    🐻 out 🔤body=🧲📄 r❗️🧲❌n🔤❗️
